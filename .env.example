# Cryptographic Session Salt (Set to a long random secret in production)
SECRET_KEY=your-production-secret-key-min-32-chars-random-string

# Server Port
PORT=5000

# SQLite Database Storage Location (Defaults to data/rainfall_app.db if omitted)
DATABASE_PATH=data/rainfall_app.db

# Optional External Database Integration (PostgreSQL / MySQL)
# DATABASE_URL=postgresql://username:password@localhost:5432/rainfall_db

# Dataset Location (Defaults to data/rainfall_in_india_1901_2015.csv)
DATASET_PATH=data/rainfall_in_india_1901_2015.csv
